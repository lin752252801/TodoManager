{
  "name": "todo-manager",
  "version": "2.1.0",
  "description": "TodoManager",
  "main": "src/main/main.js",
  "author": "Ekko",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:dir": "electron-builder --win --dir",
    "ship": "electron-builder --win --dir && node scripts/sync-green.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lagongrenren.todomanager",
    "productName": "TodoManager",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "resources/**/*"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico"
    }
  }
}
